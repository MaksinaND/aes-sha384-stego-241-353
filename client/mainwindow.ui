    border-radius: 5px;
}

QTabBar::tab {
    background-color: #3B4252;
    color: #D8DEE9;
    padding: 8px 16px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border: 1px solid #4C566A;
    border-bottom: none;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #4C566A;
    color: #ECEFF4;
}

QTabBar::tab:hover:!selected {
    background-color: #434C5E;
}</string>
